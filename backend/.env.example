# LLM Provider Key (Server-side only)
GROQ_API_KEY=

# Supabase PostgreSQL Session Pooler connection string (Server-side only)
DATABASE_URL=

# Supabase API Key (Server-side only)
SUPABASE_KEY=

# Secret key for signing session JWT tokens (Server-side only)
JWT_SECRET=

# Allowed CORS Origins (comma-separated, e.g. https://memorydesk.vercel.app)
# By default, localhost and all *.vercel.app preview/production domains are allowed.
CORS_ORIGINS=

# Port assigned by Render / hosting environment (defaults to 8000)
PORT=8000
